# EthrAUTH Environment Configuration
# Copy this file to .env and fill in your actual values

# EthrPlatform Environment Configuration
# This file is for local development and documentation purposes.
# For production, secrets are managed by ethrSECRETS (Infisical).

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ADMIN_URL=http://localhost:8080

# Zitadel Configuration
ZITADEL_MASTERKEY=your-zitadel-masterkey
ZITADEL_POSTGRES_PASSWORD=your-zitadel-postgres-password
ZITADEL_URL=http://localhost:8081

# NetBird Configuration
NETBIRD_DOMAIN=netbird.yourdomain.com
COTURN_SECRET=your-coturn-secret

# Nextcloud Configuration
NEXTCLOUD_POSTGRES_PASSWORD=your-nextcloud-postgres-password

# EthrSITE Integration
ETHRSITE_URL=http://localhost:3000
ETHRSITE_CLIENT_ID=ethrsite-frontend

# External Services (Optional)
AUTHENTIK_URL=https://authentik.yourdomain.com